# ─────────────────────────────────────────────────────────────
# Database — PostgreSQL 16 with PostGIS
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/logistics?schema=public"
DB_POOL_MAX=20
DB_POOL_MIN=2

# ─────────────────────────────────────────────────────────────
# Background jobs
# ─────────────────────────────────────────────────────────────
# The outbox drain, webhook delivery, GPS polling, the SLA scan and GPS
# retention run in `npm run worker`, not in the web server. Run it alongside
# `npm run dev` — without it the app looks healthy and delivers nothing.
#
# Set this to run all five inside the web server instead. Single-instance
# deployments only: every instance that sets it runs its own copy of the lot.
# RUN_JOBS_IN_WEB=true
#
# How long the worker waits for an in-flight pass on SIGTERM, in ms. Keep it
# under whatever the host allows between SIGTERM and SIGKILL.
# WORKER_SHUTDOWN_GRACE_MS=30000

# ─────────────────────────────────────────────────────────────
# Redis — for BullMQ, once the worker's scheduler is swapped for a queue.
# Nothing reads this yet; see docs/adr/002-background-worker.md.
# ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# Generate with:  npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3010"
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=43200
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_NAME="City Logistics"
# The origin links are built on when no tenant is established — local
# development, the template preview, the smoke scripts. A real notification
# links to the carrier's own host (customDomain, or subdomain +
# APP_ROOT_DOMAIN); the scheme and port below are reused for it, so
# http://acme.localhost:3010 works in development.
APP_URL="http://localhost:3010"
# Development fallback only. The number printed in a notification footer is
# the handling branch's, then the carrier's own Organization.supportPhone.
# Leave empty in production: a value here is shared by every tenant.
SUPPORT_PHONE=""
LR_PREFIX="CL"
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# ─────────────────────────────────────────────────────────────
# Object storage (S3-compatible: MinIO locally, S3 in prod)
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="logistics"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# ─────────────────────────────────────────────────────────────
# Per-carrier credentials
#
# Each carrier can hold their own account with the outside services — SMS
# gateway, SMTP relay, WhatsApp BSP, GPS vendor — in `tenant_credential`,
# entered by an operator at /platform/tenants/<id>. The secret column is
# AES-256-GCM ciphertext keyed from the value below.
#
# 32 bytes, as 64 hex or 43 base64url characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Not required to boot: it is demanded at the moment a credential is read or
# written, so a developer with no encrypted rows is not blocked by it. Lose
# it and every stored secret has to be re-entered by hand — keep it with the
# database backups, not in them.
CREDENTIALS_KEY=""

# ─────────────────────────────────────────────────────────────
# Notifications  (Phase 5 — start DLT registration in Phase 1)
#
# Everything below is the PLATFORM'S OWN shared account: the fallback for a
# carrier who has not been given one of their own yet. A carrier running on
# it is billed to us, shares one rate limit with every other carrier, and
# stops sending when that key is revoked — so it is shown as a warning on
# the tenant screen rather than treated as a default, and in a mature
# production deployment these are empty.
#
# The identity a message goes out under is the carrier's either way, and
# lives on Organization: dltSenderId for SMS, smtpFrom for email,
# whatsappNumber for WhatsApp. Each tenant registers their own DLT header —
# one to three weeks of external approval, per tenant.
# ─────────────────────────────────────────────────────────────
SMS_PROVIDER="mock"
SMS_API_KEY=""
# Development fallback only, behind the template's own header and then
# Organization.dltSenderId. With none of the three the send is refused
# rather than attempted — an unregistered header is dropped by the operator
# after the aggregator has already reported success.
SMS_SENDER_ID=""
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
# Development fallback only, behind Organization.smtpFrom. Sending as our
# own domain on a carrier's behalf misnames the sender and fails their SPF
# and DKIM besides.
SMTP_FROM=""

# ─────────────────────────────────────────────────────────────
# Maps & routing  (Phase 3)
# ─────────────────────────────────────────────────────────────
MAPS_PROVIDER="mock"
MAPS_API_KEY=""

# ─────────────────────────────────────────────────────────────
# GPS / telematics  (Phase 7)
# ─────────────────────────────────────────────────────────────
GPS_PROVIDER="mock"
GPS_API_BASE=""
GPS_API_KEY=""
GPS_POLL_INTERVAL_SECONDS=30
GPS_WEBHOOK_SECRET=""
# Raw fixes stay at full resolution for RETENTION_DAYS, are then thinned to
# one fix per five minutes (plus every ignition transition — a detention
# claim turns on both edges of a stop), and deleted past ARCHIVE_DAYS.
GPS_RETENTION_DAYS=90
GPS_ARCHIVE_DAYS=400
GPS_RETENTION_INTERVAL_HOURS=24

# ─────────────────────────────────────────────────────────────
# E-way bill via GSP  (Phase 3)
# ─────────────────────────────────────────────────────────────
EWAYBILL_ENABLED=false
EWAYBILL_GSP_BASE=""
EWAYBILL_USERNAME=""
EWAYBILL_PASSWORD=""
EWAYBILL_GSTIN=""

# The platform domain tenants are subdomains of.
APP_ROOT_DOMAIN=localhost

# ── Trusted proxies ───────────────────────────────────────────────────
# How many reverse proxies stand between the internet and the app. This is
# what makes the client address knowable: `X-Forwarded-For` grows left to
# right, so behind one load balancer the caller is the LAST entry, behind
# two it is the second from last, and behind none no entry can be believed
# at all — anyone can send the header.
#
#   0  no proxy (the default, and the safe one)
#   1  a single nginx / ALB / Caddy in front
#   2  a CDN in front of that
#
# Set too low: an API key's IP allowlist refuses, and audit rows lose the
# address. Set too high: a forged header is recorded and trusted as fact.
# The proxy must also OVERWRITE the forwarding headers on ingress rather
# than appending to whatever the client sent.
TRUSTED_PROXY_HOPS=0

# ── Row-level security (ADR 001 §1) ───────────────────────────────────
# The second isolation mechanism (ADR 001 §1). Turn this on for any
# deployment that carries real data: it has teeth only when the app also
# connects as the non-owner role below, and the two go together — see the
# README. Left `off` here so a first `npm run dev` on a fresh clone works
# before the role exists; `npm run tenant:verify` refuses to pass while it
# is off, rather than skipping the probes and reporting success.
TENANT_RLS=off
# The application's own database role, created by scripts/apply-rls.mjs.
APP_DB_ROLE=logistics_app
APP_DB_PASSWORD=
# The owner's connection, used by Prisma Migrate once DATABASE_URL points
# at the restricted role.
MIGRATE_DATABASE_URL=
