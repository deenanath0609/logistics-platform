# ─────────────────────────────────────────────────────────────
# Database — PostgreSQL 16 with PostGIS
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/logistics?schema=public"
DB_POOL_MAX=20
DB_POOL_MIN=2

# ─────────────────────────────────────────────────────────────
# Redis — BullMQ job queues
# ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"

# ─────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────
# Generate with:  npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3010"
AUTH_TRUST_HOST=true
SESSION_MAX_AGE_SECONDS=43200
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
APP_NAME="City Logistics"
APP_URL="http://localhost:3010"
# Printed in notification footers when the handling branch has no number
# on file. Without it a delivery confirmation can fail to render.
SUPPORT_PHONE="1800-000-000"
LR_PREFIX="CL"
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"

# ─────────────────────────────────────────────────────────────
# Object storage (S3-compatible: MinIO locally, S3 in prod)
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="logistics"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900

# ─────────────────────────────────────────────────────────────
# Notifications  (Phase 5 — start DLT registration in Phase 1)
# ─────────────────────────────────────────────────────────────
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID=""
WHATSAPP_PROVIDER="mock"
WHATSAPP_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="City Logistics <noreply@example.com>"

# ─────────────────────────────────────────────────────────────
# Maps & routing  (Phase 3)
# ─────────────────────────────────────────────────────────────
MAPS_PROVIDER="mock"
MAPS_API_KEY=""

# ─────────────────────────────────────────────────────────────
# GPS / telematics  (Phase 7)
# ─────────────────────────────────────────────────────────────
GPS_PROVIDER="mock"
GPS_API_BASE=""
GPS_API_KEY=""
GPS_POLL_INTERVAL_SECONDS=30
GPS_WEBHOOK_SECRET=""
# Raw fixes stay at full resolution for RETENTION_DAYS, are then thinned to
# one fix per five minutes (plus every ignition transition — a detention
# claim turns on both edges of a stop), and deleted past ARCHIVE_DAYS.
GPS_RETENTION_DAYS=90
GPS_ARCHIVE_DAYS=400
GPS_RETENTION_INTERVAL_HOURS=24

# ─────────────────────────────────────────────────────────────
# E-way bill via GSP  (Phase 3)
# ─────────────────────────────────────────────────────────────
EWAYBILL_ENABLED=false
EWAYBILL_GSP_BASE=""
EWAYBILL_USERNAME=""
EWAYBILL_PASSWORD=""
EWAYBILL_GSTIN=""
